{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/demo-bank",
  "sourceRoot": "apps/demo-bank/src",
  "compilerOptions": { "deleteOutDir": false },
  "projects": {
    "demo-bank": {
      "type": "application",
      "root": "apps/demo-bank",
      "entryFile": "main",
      "sourceRoot": "apps/demo-bank/src",
      "compilerOptions": { "tsConfigPath": "apps/demo-bank/tsconfig.app.json" }
    },
    "contracts": {
      "type": "library",
      "root": "libs/contracts",
      "entryFile": "index",
      "sourceRoot": "libs/contracts/src",
      "compilerOptions": { "tsConfigPath": "libs/contracts/tsconfig.lib.json" }
    }
  }
}
